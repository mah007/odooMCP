# Required: used for JWT signing and Fernet encryption of Odoo credentials
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-hex-string

# Service ports (defaults shown)
MCP_PORT=8000
CONTROLLER_PORT=8001

# Optional: path to SQLite database (default: ./data/mcp.db)
# DB_PATH=/app/data/mcp.db

# Optional (v3) — defaults shown
# MCP_MAX_LIMIT=500                 # highest limit a search/aggregate may ask for
# MCP_MAX_RESPONSE_BYTES=100000     # size guard for every tool response
# MCP_ALLOWED_ORIGINS=              # comma-separated browser origins allowed to call /mcp
# MCP_READ_KEY_BLOCKLIST=ir.config_parameter,res.users.apikeys,res.groups,base.automation
